// Cloudflare Worker configuration.
//
// The "Deploy to Cloudflare" button reads this file: it provisions the D1 database
// declared below, writes the real database_id into your copy of the repo, and wires
// the repo to Workers Builds so every push to main redeploys automatically
// (build command: `npm run build`, deploy command: `npx wrangler deploy`).
//
// Keep `main`, `assets` and the `DB` binding valid — the app reads all three.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "control-y",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  // Custom domain. Cloudflare creates/maintains the DNS record for this hostname
  // on deploy. Declaring any route makes wrangler default `workers_dev` to false,
  // so control-y.netmind-ai.workers.dev stops serving — pinned explicitly below
  // so that stays a decision rather than an implicit default.
  "routes": [
    {
      "pattern": "ctrl-y.manyfold.ai",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  // Every minute: advance any running pass (src/worker/panel.ts `advancePasses`).
  // The review page does the same while it is open; this is what finishes a pass
  // after the tab is closed. Idle cost is one D1 query per minute.
  "triggers": {
    "crons": ["* * * * *"]
  },
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "manyfold-app-db",
      "database_id": "2593ce02-4386-4306-8bc5-d9595b1bdaa4"
    }
  ],
  // Uploaded documents. The browser PUTs straight to R2 through a presigned URL, so the
  // Worker only ever uses this binding to confirm, stream back and delete objects.
  //
  // "remote": true is load-bearing for `npm run dev`: the presigned URL always points at
  // real R2, so a locally simulated bucket would never see the object the browser just
  // uploaded. preview_bucket_name keeps that dev traffic out of the production bucket.
  "r2_buckets": [
    {
      "binding": "DOCS",
      "bucket_name": "control-y-docs",
      "preview_bucket_name": "control-y-docs-dev",
      "remote": true
    }
  ],
  "vars": {
    // Manyfold API base. Point at https://api-staging.manyfold.ai via .dev.vars for local dev.
    "MANYFOLD_API_BASE_URL": "https://api.manyfold.ai",
    // "production" enforces https-only and no-private-IP checks on agent URLs.
    "ENVIRONMENT": "production",
    // Which bucket the presigned URLs address. Must name the same bucket the DOCS binding
    // resolves to, so .dev.vars overrides it to control-y-docs-dev for local development.
    "R2_BUCKET": "control-y-docs"
  }
  // Optional hardening, neither is required to deploy:
  //   npx wrangler secret put ADMIN_PASSWORD          # locks the app behind a password
  //   npx wrangler secret put CONFIG_ENCRYPTION_KEY   # >=32 chars; otherwise a key is generated and stored in D1
}
